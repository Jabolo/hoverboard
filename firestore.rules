rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    function validRating(userId) {
      return request.resource.data.keys().hasAll(["contentRating", "styleRating", "comment", "userId"])
        && request.resource.data.keys().hasOnly(["contentRating", "styleRating", "comment", "userId"])
        && request.resource.data.contentRating >= 0
        && request.resource.data.contentRating <= 5
        && request.resource.data.styleRating >= 0
        && request.resource.data.styleRating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 256
        && request.resource.data.userId is string
        && request.resource.data.userId == userId
        && request.resource.data.userId == request.auth.uid;
    }

    match /blog/{post} {
      allow get, list;
      allow write: if false;
    }

    match /config/{config} {
      allow read, write: if false;
    }

    match /functionsRateLimits/{docId} {
      allow read, write: if false;
    }

    // An epoch tombstone revokes stale clients when a collection is deleted.
    match /huntCollectionSessions/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == "google.com";
      }
      function validSession() {
        return request.resource.data.keys().hasOnly(["epoch", "enabled"])
          && request.resource.data.keys().hasAll(["epoch", "enabled"])
          && request.resource.data.epoch is string
          && request.resource.data.epoch.matches("^[a-f0-9]{32}$")
          && request.resource.data.enabled is bool;
      }
      allow get: if owner();
      allow list, delete: if false;
      allow create: if owner() && validSession() && request.resource.data.enabled;
      allow update: if owner() && validSession()
        && request.resource.data.enabled != resource.data.enabled
        && request.resource.data.epoch != resource.data.epoch;
    }

    // Optional Y2K collection. This is a personal souvenir, not proof of attendance
    // or a prize entry: clients can write their own records, so counts are indicative.
    match /huntCollections/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == "google.com";
      }
      function validCard(card, state) {
        return card is map
          && card.keys().hasAll(["id", "title", "group"])
          && card.id is string && card.id.matches("^[a-z0-9]{7}$")
          && card.title is string && card.title.size() > 0 && card.title.size() <= 200
          && card.group in ["web", "play", "venue", "mystery", "preview"]
          && (state == "found"
            ? card.keys().hasOnly(["id", "title", "group"])
            : card.keys().hasAll(["text"])
              && card.keys().hasOnly(["id", "title", "group", "text", "game"])
              && card.text is string && card.text.size() <= 4000
              && (!("game" in card) || card.game == "signal"));
      }
      function validEntry(entryId, data) {
        return data.keys().hasAll(["state", "card", "foundAt"])
          && data.state in ["found", "earned"]
          && validCard(data.card, data.state)
          && entryId == data.state + "_" + data.card.id
          && data.foundAt is number && data.foundAt >= 0
          && (data.state == "found"
            ? data.keys().hasOnly(["state", "card", "foundAt"])
            : data.keys().hasAll(["earnedAt"])
              && data.keys().hasOnly(["state", "card", "foundAt", "earnedAt"])
              && data.earnedAt is number && data.earnedAt >= 0);
      }
      function validEnvelope() {
        return request.resource.data.keys().hasOnly(["entries", "changedKey", "epoch"])
          && request.resource.data.keys().hasAll(["entries", "changedKey", "epoch"])
          && request.resource.data.entries is map
          && request.resource.data.entries.size() <= 64
          && request.resource.data.changedKey is string
          && request.resource.data.changedKey in request.resource.data.entries
          && validEntry(request.resource.data.changedKey,
                        request.resource.data.entries[request.resource.data.changedKey]);
      }
      function activeSession() {
        let session = get(/databases/$(database)/documents/huntCollectionSessions/$(userId));
        return session.data.enabled == true
          && session.data.epoch == request.resource.data.epoch;
      }
      function validCreate() {
        return validEnvelope() && request.resource.data.entries.size() == 1;
      }
      function validUpdate() {
        return validEnvelope() && request.resource.data.entries.diff(resource.data.entries)
          .affectedKeys().hasOnly([request.resource.data.changedKey]);
      }
      allow get: if owner();
      allow list: if false;
      allow delete: if owner()
        && getAfter(/databases/$(database)/documents/huntCollectionSessions/$(userId)).data.enabled == false;
      allow create: if owner() && activeSession() && validCreate();
      allow update: if owner() && activeSession() && validUpdate();
    }

    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    function validFeaturedSessions() {
      return request.resource.data is map && request.resource.data.size() <= 200;
    }

    match /featuredSessions/{userId} {
      allow get: if request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth.uid == userId && validFeaturedSessions();
      allow delete: if request.auth.uid == userId;
    }

    match /gallery/{photo} {
      allow get, list;
      allow write: if false;
    }

    function validSubscriberToken(token) {
      return token.size() >= 10 && token.size() <= 256
        && request.resource.data.keys().hasAll(["value", "updatedAt"])
        && request.resource.data.keys().hasOnly(["value", "updatedAt"])
        && request.resource.data.value is bool
        && request.resource.data.updatedAt is timestamp;
    }

    match /notificationsSubscribers/{token} {
      allow list: if false;
      allow get;
      allow create, update: if validSubscriberToken(token);
      allow delete: if token.size() >= 10 && token.size() <= 256;
    }

    function validNotificationsUsers() {
      return request.resource.data.keys().hasOnly(["tokens"])
        && request.resource.data.tokens is map
        && request.resource.data.tokens.size() <= 20;
    }

    match /notificationsUsers/{userId} {
      allow get: if request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth.uid == userId && validNotificationsUsers();
      allow delete: if request.auth.uid == userId;
    }

    match /partners/{groupId} {
      allow get, list;
      allow write: if false;

      match /items/{itemId} {
        allow get, list;
        allow write: if false;
      }
    }

    // Scoped collectionGroup rule for partners items
    match /{path=**}/items/{itemId} {
      allow get, list: if path[0] == "partners";
      allow write: if false;
    }

    match /potentialPartners/{partnerId} {
      allow read, update, delete: if false;

      allow create: if request.resource.data.keys().hasAll(["email", "fullName", "companyName"])
                    && request.resource.data.keys().hasOnly(["email", "fullName", "companyName"])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.email.matches("^[^@]+@[^@]+\\.[^@]+$")
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.companyName is string
                    && request.resource.data.companyName.size() > 0
                    && request.resource.data.companyName.size() <= 120;
    }

    match /previousSpeakers/{speaker} {
      allow get, list;
      allow write: if false;
    }

    match /schedule/{day} {
      allow get, list;
      allow write: if false;
    }

    match /generatedSchedule/{day} {
      allow get, list;
      allow write: if false;
    }

    match /sessions/{session} {
      allow get, list;
      allow write: if false;
    }

    // Unified, unshadowed collection group & document rules for feedback
    match /{path=**}/feedback/{userId} {
      allow get, delete: if request.auth.uid == userId;
      allow list: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == userId && validRating(userId);
      allow update: if request.auth.uid == userId
                    && resource.data.userId == userId
                    && validRating(userId);
    }

    match /generatedSessions/{session} {
      allow get, list;
      allow write: if false;
    }

    match /speakers/{speaker} {
      allow get, list;
      allow write: if false;
    }

    match /generatedSpeakers/{speaker} {
      allow get, list;
      allow write: if false;
    }

    match /subscribers/{subscriberId} {
      allow read, write: if false;
    }

    match /newsletterContacts/{contactId} {
      allow read, write: if false;
    }

    match /team/{teamId} {
      allow get, list;
      allow write: if false;

      match /members/{memberId} {
        allow get, list;
        allow write: if false;
      }
    }

    // Scoped collectionGroup rule for team members
    match /{path=**}/members/{memberId} {
      allow get, list: if path[0] == "team";
      allow write: if false;
    }

    match /tickets/{ticket} {
      allow get, list;
      allow write: if false;
    }

    match /users/{userId} {
      allow list: if false;
      allow get: if request.auth.uid == userId;
      allow write: if false;
    }

    match /videos/{video} {
      allow get, list;
      allow write: if false;
    }
  }
}
