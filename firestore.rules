rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    function validRating(userId) {
      return request.resource.data.keys().hasAll(["contentRating", "styleRating", "comment", "userId"])
        && request.resource.data.keys().hasOnly(["contentRating", "styleRating", "comment", "userId"])
        && request.resource.data.contentRating >= 0
        && request.resource.data.contentRating <= 5
        && request.resource.data.styleRating >= 0
        && request.resource.data.styleRating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 256
        && request.resource.data.userId is string
        && request.resource.data.userId == userId
        && request.resource.data.userId == request.auth.uid;
    }

    match /blog/{post} {
      allow get, list;
      allow write: if false;
    }

    match /config/{config} {
      allow read, write: if false;
    }

    match /functionsRateLimits/{docId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    function validFeaturedSessions() {
      return request.resource.data is map && request.resource.data.size() <= 200;
    }

    match /featuredSessions/{userId} {
      allow get: if request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth.uid == userId && validFeaturedSessions();
      allow delete: if request.auth.uid == userId;
    }

    match /gallery/{photo} {
      allow get, list;
      allow write: if false;
    }

    function validSubscriberToken(token) {
      return token.size() >= 10 && token.size() <= 256
        && request.resource.data.keys().hasAll(["value", "updatedAt"])
        && request.resource.data.keys().hasOnly(["value", "updatedAt"])
        && request.resource.data.value is bool
        && request.resource.data.updatedAt is timestamp;
    }

    match /notificationsSubscribers/{token} {
      allow list: if false;
      allow get;
      allow create, update: if validSubscriberToken(token);
      allow delete: if token.size() >= 10 && token.size() <= 256;
    }

    function validNotificationsUsers() {
      return request.resource.data.keys().hasOnly(["tokens"])
        && request.resource.data.tokens is map
        && request.resource.data.tokens.size() <= 20;
    }

    match /notificationsUsers/{userId} {
      allow get: if request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth.uid == userId && validNotificationsUsers();
      allow delete: if request.auth.uid == userId;
    }

    match /partners/{groupId} {
      allow get, list;
      allow write: if false;

      match /items/{itemId} {
        allow get, list;
        allow write: if false;
      }
    }

    // Scoped collectionGroup rule for partners items
    match /{path=**}/items/{itemId} {
      allow get, list: if path[0] == "partners";
      allow write: if false;
    }

    match /potentialPartners/{partnerId} {
      allow read, update, delete: if false;

      allow create: if request.resource.data.keys().hasAll(["email", "fullName", "companyName"])
                    && request.resource.data.keys().hasOnly(["email", "fullName", "companyName"])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.email.matches("^[^@]+@[^@]+\\.[^@]+$")
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.companyName is string
                    && request.resource.data.companyName.size() > 0
                    && request.resource.data.companyName.size() <= 120;
    }

    match /previousSpeakers/{speaker} {
      allow get, list;
      allow write: if false;
    }

    match /schedule/{day} {
      allow get, list;
      allow write: if false;
    }

    match /generatedSchedule/{day} {
      allow get, list;
      allow write: if false;
    }

    match /sessions/{session} {
      allow get, list;
      allow write: if false;
    }

    // Unified, unshadowed collection group & document rules for feedback
    match /{path=**}/feedback/{userId} {
      allow get, delete: if request.auth.uid == userId;
      allow list: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == userId && validRating(userId);
      allow update: if request.auth.uid == userId
                    && resource.data.userId == userId
                    && validRating(userId);
    }

    match /generatedSessions/{session} {
      allow get, list;
      allow write: if false;
    }

    match /speakers/{speaker} {
      allow get, list;
      allow write: if false;
    }

    match /generatedSpeakers/{speaker} {
      allow get, list;
      allow write: if false;
    }

    match /subscribers/{subscriberId} {
      allow read, write: if false;
    }

    match /newsletterContacts/{contactId} {
      allow read, write: if false;
    }

    match /team/{teamId} {
      allow get, list;
      allow write: if false;

      match /members/{memberId} {
        allow get, list;
        allow write: if false;
      }
    }

    // Scoped collectionGroup rule for team members
    match /{path=**}/members/{memberId} {
      allow get, list: if path[0] == "team";
      allow write: if false;
    }

    match /tickets/{ticket} {
      allow get, list;
      allow write: if false;
    }

    match /users/{userId} {
      allow list: if false;
      allow get: if request.auth.uid == userId;
      allow write: if false;
    }

    match /videos/{video} {
      allow get, list;
      allow write: if false;
    }
  }
}
